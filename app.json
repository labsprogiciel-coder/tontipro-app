{
  "expo": {
    "name": "kauridoor",
    "slug": "kauridoor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kauridoor",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.tontipro.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Autoriser Kauri à accéder à la caméra pour scanner les QR codes d'enregistrement des TPE.",
        "NSLocationWhenInUseUsageDescription": "Autoriser Kauri à accéder à votre localisation pour enregistrer la position du TPE et faciliter son suivi.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Autoriser Kauri à accéder à votre localisation pour enregistrer la position du TPE."
      },
      "entitlements": {
        "com": {
          "apple": {
            "developer": {
              "networking": {
                "wifi-info": true
              }
            }
          }
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.tontipro.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://rork.app/"
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Autoriser Kauri à accéder à la caméra pour scanner les QR codes d'enregistrement des TPE."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Autoriser Kauri à accéder à votre localisation pour enregistrer la position du TPE et faciliter son suivi."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "b5d56152-5049-4f06-8582-743fa70398f3"
      }
    },
    "owner": "progiciel"
  }
}
